# ============================================
# MLflow
# ============================================
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=impayes-telecom
MLFLOW_MODEL_NAME=impayes-classifier

# ============================================
# API FastAPI
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# ============================================
# Chemins du projet
# ============================================
DATA_RAW_PATH=data/raw/telecom_credit_scoring_nigeria.csv
DATA_PROCESSED_PATH=data/processed/features.parquet
MODEL_PATH=models/model.pkl

# ============================================
# Monitoring
# ============================================
DRIFT_THRESHOLD_PSI=0.2
F1_ALERT_THRESHOLD=0.75
LATENCY_P95_THRESHOLD_MS=500

# ============================================
# DVC (remote local)
# ============================================
DVC_REMOTE_PATH=../dvc-storage

# ============================================
# (Optionnel) Remote S3 - à décommenter plus tard
# ============================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
