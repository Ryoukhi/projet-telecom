# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/
.env

# Données (versionnées avec DVC, pas Git !)
data/raw/*
data/processed/*
data/interim/*
!data/**/.gitkeep

# MLflow
mlruns/
mlartifacts/

# DVC
.dvc/cache/
.dvc/tmp/

# Modèles
*.pkl
*.joblib
*.h5
*.onnx
!models/model.pkl

# Notebooks
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Reports
reports/figures/*.png
reports/metrics/*
!reports/**/.gitkeep

# Docker
*.log

# Build and lock artifacts
build/
dist/
pip-wheel-metadata/
reports/


# Mais on autorise les pointeurs DVC et les .gitignore locaux
!data/raw/.gitignore
!data/raw/*.dvc
!data/processed/.gitignore
!data/processed/*.dvc
!data/interim/.gitignore
!data/interim/*.dvc
